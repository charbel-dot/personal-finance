{
  "name": "money-app",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "vite build && wrangler pages dev dist --port 8788 --persist-to .wrangler/state",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler pages dev dist --port 8788 --persist-to .wrangler/state",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "hash-password": "node scripts/hash-password.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "doctor": "npx -y react-doctor@latest .",
    "deploy": "npm run build && wrangler pages deploy dist --project-name money-app --branch main && npm run deploy:cron",
    "deploy:cron": "wrangler deploy --config cron/wrangler.toml --env=\"\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "glisse": "^0.5.0",
    "hono": "^4.13.17",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0"
  }
}
