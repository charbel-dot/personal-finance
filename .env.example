# Copy to `.dev.vars` for local development (wrangler reads .dev.vars, never commit it).
# In production these are Cloudflare secrets — see README "Secrets".

# Login username
AUTH_USERNAME=me

# Output of: npm run hash-password
AUTH_PASSWORD_HASH=pbkdf2_sha256:100000:<salt>:<hash>

# At least 32 random characters. Generate with: npm run hash-password -- --secret
SESSION_SECRET=<random-32-bytes-base64url>
